<%- include('./partials/header') %>

    <section class="banner small-banner">
        <div class="container">
            <h1>Engineering Services</h1>
            <p class="subtitle">Focused testing solutions for startups and growing manufacturers.</p>
        </div>
    </section>

    <section class="section-services">
        <div class="container">
            <div class="services-grid">
                <!-- Service 1 -->
                <div class="service-card fade-up">
                    <h3>Prototype PCB Electrical Testing</h3>
                    <p>Early-stage electrical validation for prototype and small-run PCBs.</p>
                </div>
                <!-- Service 2 -->
                <div class="service-card fade-up">
                    <h3>DFM / DFT Review</h3>
                    <p>Design and testability reviews to catch issues before fabrication.</p>
                </div>
                <!-- Service 3 -->
                <div class="service-card fade-up">
                    <h3>Failure Analysis & Debug Support</h3>
                    <p>Supporting teams in identifying and resolving early-stage PCB issues.</p>
                </div>
            </div>

            <!-- Expansion Note -->
            <div class="expansion-note text-center fade-up" style="margin-top: var(--spacing-xl); opacity: 0.8;">
                <p>We are actively building additional services. <a href="/contact"
                        style="text-decoration: underline; color: var(--color-gold);">Reach out</a> to discuss upcoming
                    offerings.</p>
            </div>
        </div>
    </section>

    <%- include('./partials/footer') %>