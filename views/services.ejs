<%- include('./partials/header') %>

    <section class="banner small-banner">
        <div class="container">
            <h1>Engineering Services</h1>
            <p class="subtitle">Focused testing solutions for startups and growing manufacturers.</p>
        </div>
    </section>

    <section class="section-services">
        <div class="container">
            <div class="services-grid">
                <!-- Service 1 -->
                <div class="service-card fade-up">
                    <h3>Continuity & Shorts Testing</h3>
                    <p>Comprehensive electrical continuity and short circuit detection to ensure proper PCB connectivity and prevent manufacturing defects.</p>
                </div>
                <!-- Service 2 -->
                <div class="service-card fade-up">
                    <h3>Controlled Power-On Testing</h3>
                    <p>Systematic power sequencing and validation to verify safe power-up behavior and prevent damage during initial energization.</p>
                </div>
                <!-- Service 3 -->
                <div class="service-card fade-up">
                    <h3>Functional Testing</h3>
                    <p>End-to-end functional validation ensuring your hardware meets design specifications and performs as intended.</p>
                </div>
            </div>

            <!-- Expansion Note -->
            <div class="expansion-note text-center fade-up" style="margin-top: var(--spacing-xl); opacity: 0.8;">
                <p>We are actively building additional services. <a href="/contact"
                        style="text-decoration: underline; color: var(--color-gold);">Reach out</a> to discuss upcoming
                    offerings.</p>
            </div>
        </div>
    </section>

    <%- include('./partials/footer') %>