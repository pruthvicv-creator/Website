<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="<%= locals.description ? description : 'Laminar Circuits - Reliable PCB Validation & Testing Services' %>">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://www.laminarcircuits.com<%= page === 'home' ? '' : '/' + page %>">
    <meta property="og:title" content="<%= title %> | Laminar Circuits">
    <meta property="og:description"
        content="<%= locals.description ? description : 'Reliable PCB Validation & Testing Services' %>">
    <meta property="og:image" content="https://www.laminarcircuits.com/images/laminar_logo_hq.jpg">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://www.laminarcircuits.com<%= page === 'home' ? '' : '/' + page %>">
    <meta property="twitter:title" content="<%= title %> | Laminar Circuits">
    <meta property="twitter:description"
        content="<%= locals.description ? description : 'Reliable PCB Validation & Testing Services' %>">
    <meta property="twitter:image" content="https://www.laminarcircuits.com/images/laminar_logo_hq.jpg">

    <title>
        <%= title %> | Laminar Circuits
    </title>
    <link rel="stylesheet" href="/css/style.css">
    <!-- Google Fonts: Inter and Space Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
        rel="stylesheet">
    <!-- GSAP via CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.4/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.4/ScrollTrigger.min.js"></script>
</head>

<body class="page-<%= page %>">
    <header class="site-header">
        <div class="container header-inner">
            <a href="/" class="logo">
                <img src="/images/laminar_logo_hq.jpg" alt="Laminar Circuits" style="height: 50px; width: auto;">
            </a>
            <nav>
                <ul class="nav-list">
                    <li><a href="/services" class="<%= page === 'services' ? 'active' : '' %>">Services</a></li>
                    <li><a href="/about" class="<%= page === 'about' ? 'active' : '' %>">About</a></li>
                    <li><a href="/contact" class="btn btn-sm">Contact</a></li>
                </ul>
            </nav>
        </div>
    </header>
    <main>