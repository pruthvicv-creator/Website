<%- include('./partials/header') %>

    <section class="banner small-banner">
        <div class="container">
            <h1>Lab Capabilities</h1>
            <p class="subtitle">State-of-the-art infrastructure for zero-defect assurance.</p>
        </div>
    </section>

    <section class="section-capabilities" style="padding: var(--section-padding) 0;">
        <div class="container">
            <h2 class="section-title">Current Capabilities</h2>
            <div class="services-grid"> <!-- Reusing grid for consistent card layout -->
                <!-- Cap 1 -->
                <div class="service-card fade-up">
                    <h3>Manual & Semi-Automated Electrical Test Setup</h3>
                    <p>Flexible probe-based testing for early-stage hardware.</p>
                </div>
                <!-- Cap 2 -->
                <div class="service-card fade-up">
                    <h3>Structured Testing Workflows</h3>
                    <p>Defined test plans, execution checklists, and traceable results.</p>
                </div>
                <!-- Cap 3 -->
                <div class="service-card fade-up">
                    <h3>Basic Reporting & Traceability</h3>
                    <p>Clear pass/fail summaries with documented observations.</p>
                </div>
            </div>

            <!-- Expansion Note -->
            <div class="expansion-note text-center fade-up" style="margin-top: var(--spacing-xl); opacity: 0.8;">
                <p>Our capabilities are expanding as we scale our lab and processes. <a href="/contact"
                        style="text-decoration: underline; color: var(--color-gold);">Reach out</a> to connect and
                    discuss future requirements.</p>
            </div>
        </div>
    </section>

    <%- include('./partials/footer') %>