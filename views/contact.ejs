<%- include('./partials/header') %>

    <section class="banner small-banner">
        <div class="container">
            <h1>Start a Project</h1>
            <p class="subtitle">Technical inquiries and quote requests.</p>
        </div>
    </section>

    <section class="contact-section">
        <div class="container contact-layout">
            <div class="contact-form-wrapper">
                <form action="/contact" method="POST" class="contact-form">
                    <div class="form-group">
                        <label>Name</label>
                        <input type="text" name="name" placeholder="Engineer Name" required>
                    </div>
                    <div class="form-group">
                        <label>Company Email</label>
                        <input type="email" name="email" placeholder="name@company.com" required>
                    </div>

                    <div class="form-group">
                        <label>Technical Requirements</label>
                        <textarea name="message" rows="5" placeholder="Briefly describe your testing needs..."
                            required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Submit Inquiry</button>
                </form>
            </div>
            <!-- Removed Headquarters Info -->
        </div>
    </section>

    <%- include('./partials/footer') %>